int divide_by_two(int value) {
    if (value == 1) {
        return 0;
    }
    return value / 2;
}

int remainder_by_two(int value) {
    return value % 2;
}

int divide_by_five(int value) {
    return value / 5;
}

int remainder_by_negative_seven(int value) {
    return value % -7;
}

int divide_by_large(int value) {
    return value / 123456789;
}

int main() {
    int value = getint();
    int result = divide_by_two(value);
    result = result + remainder_by_two(value);
    result = result + divide_by_five(value);
    result = result + remainder_by_negative_seven(value);
    result = result + divide_by_large(value);
    putint(result);
    return 0;
}
