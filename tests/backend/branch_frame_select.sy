int branch_nonzero(int x) {
  int result = 0;
  if (x) {
    result = x + 1;
  } else {
    result = x - 1;
  }
  return result;
}

int branch_parity(int x) {
  int result = 0;
  if (x % 2 == 0) {
    result = x + 3;
  } else {
    result = x - 3;
  }
  return result;
}

int leaf_sum(int values[], int count) {
  int i = 0;
  int sum = 0;
  while (i < count) {
    sum = sum + values[i];
    i = i + 1;
  }
  return sum;
}

int main() {
  int values[4] = {1, 2, 3, 4};
  int input = getint();
  return branch_nonzero(input) + branch_parity(input) + leaf_sum(values, 4);
}
